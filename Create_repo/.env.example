# [Canvas Configuration] :
CANVAS_DOMAIN_NAME=oc.sjtu.edu.cn
# Canvas domain name (default: oc.sjtu.edu.cn)
CANVAS_SUFFIX=/
# Canvas URL suffix (default: /)
CANVAS_ACCESS_TOKEN=your_canvas_token
# Canvas API access token
CANVAS_COURSE_ID=your_course_id
# Canvas course ID

# [Gitea Configuration] :
GITEA_DOMAIN_NAME=focs.ji.sjtu.edu.cn
# Gitea domain name (default: focs.ji.sjtu.edu.cn)
GITEA_SUFFIX=/git
# Gitea URL suffix (default: /git)
GITEA_ACCESS_TOKEN=your_gitea_token
# Gitea API access token
GITEA_ORG_NAME=tests
# Gitea organization name
GITEA_DEBUG=true
# Enable Gitea debug mode (default: false)

# [Git Configuration] :
GIT_HOST=ssh://git@focs.ji.sjtu.edu.cn:2222
# Git SSH host (default: ssh://git@focs.ji.sjtu.edu.cn:2222)
REPOS_DIR=./repos
# Local repositories directory (default: ./repos)
DEFAULT_BRANCH=master
# Default git branch (default: master)

# [Mattermost Configuration] :
MATTERMOST_DOMAIN_NAME=focs.ji.sjtu.edu.cn
# Mattermost domain name (default: focs.ji.sjtu.edu.cn)
MATTERMOST_SUFFIX=/mm
# Mattermost URL suffix (default: /mm)
MATTERMOST_TEAM=your_team_name
# Mattermost team name
MATTERMOST_ACCESS_TOKEN=your_mattermost_token
# Mattermost API access token
MATTERMOST_TEACHING_TEAM=["teacher1", "teacher2"]
# Teaching team members list

# [JOJ Configuration] :
JOJ_SID=your_joj_session_id
# JOJ session ID

# [JOJ3 Configuration] :
JOJ3_LOCK_FILE_PATH=.git/teapot.lock
# JOJ3 lock file path (default: .git/teapot.lock)
JOJ3_LOCK_FILE_TIMEOUT=30
# JOJ3 lock file timeout in seconds (default: 30)

# [MOSS Configuration] :
MOSS_USER_ID=9876543210
# MOSS user ID (default: 9876543210)

# [Logging Configuration] :
LOG_FILE_PATH=joint-teapot.log
# Log file path (default: joint-teapot.log)
STDERR_LOG_LEVEL=INFO
# Console log level (default: INFO)
